# Comma-separated pool of at least 2 LLM API keys (mapped to key_1, key_2, ... in order)
LLM_API_KEYS=your-first-api-key,your-second-api-key

# LiteLLM model identifier (or comma-separated models aligned with LLM_API_KEYS)
# Examples: gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.3-70b-versatile
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite database URL (in Docker, /data is mounted to a persistent volume)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure test hook (true/false)
ENABLE_FAILURE_SIMULATION=true

# Optional: Default system prompt used when session does not provide one
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Optional: Cache type (local for in-memory, disk for disk cache) and TTL in seconds
CACHE_TYPE=local
CACHE_TTL_SECONDS=3600

# Frontend build/runtime API base URL
VITE_API_BASE_URL=http://localhost:8000
